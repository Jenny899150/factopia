# 复制为 .env 后填写；.env 不提交到 Git

# ---- 基础 ----
FACTOPIA_DATA_DIR=/workspace/runtime/data
FACTOPIA_QLIB_DIR=/workspace/runtime/qlib_data
MLFLOW_TRACKING_URI=http://mlflow:5000

# ---- LLM（RD-Agent 使用）----
BACKEND=rdagent.oai.backend.LiteLLMAPIBackend
# 对话模型：硅基流动（OpenAI 兼容平台，API Key 在 https://cloud.siliconflow.cn「API 密钥」页创建）
# 模型列表见 https://siliconflow.cn/models；换模型只需改 litellm_proxy/ 后面的部分
CHAT_MODEL=litellm_proxy/zai-org/GLM-5.3
LITELLM_PROXY_API_BASE=https://api.siliconflow.cn/v1
LITELLM_PROXY_API_KEY=
# 向量模型：硅基流动 BAAI/bge-m3（与上面同一个 API Key）
EMBEDDING_MODEL=litellm_proxy/BAAI/bge-m3

# ---- RD-Agent 回测容器（按本机内存调整）----
QLIB_DOCKER_MEM_LIMIT=8g
QLIB_DOCKER_SHM_SIZE=2g
QLIB_DOCKER_ENABLE_GPU=False

# ---- RD-Agent Web UI（rdagent-web）----
# 访问令牌，必填；生成方式：python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
UI_SERVER_AUTH_TOKEN=

# ---- Factopia Web 界面（web 服务）----
# 默认只允许本机访问。云服务器对外开放前须先加 HTTPS 与登录，再改为 0.0.0.0
FACTOPIA_WEB_BIND=127.0.0.1
FACTOPIA_WEB_PORT=18080

# ---- 模拟盘（factopia.paper）----
# 影子撮合模式的初始资金（默认 1000000，可用 base_currency 口径）
FACTOPIA_PAPER_CAPITAL=1000000
# 长桥 LongPort 通道（可选）：三个变量全非空才启用，且只支持港股。
# 在长桥开发者中心开通模拟账户后获取；接入中途不要改动（模式在接入时固化到 enrolled.json）
LONGPORT_APP_KEY=
LONGPORT_APP_SECRET=
LONGPORT_ACCESS_TOKEN=
